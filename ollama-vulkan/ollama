#!/bin/bash
docker run --rm -it --network host \
       -v ~/.ollama:/home/devel/.ollama \
       -v ~/.local:/home/devel/.local \
       -v ~/.cache:/home/devel/.cache \
       -v ~/.config:/home/devel/.config \
       -v ~/.nvm:/home/devel/.nvm \
       -v ~/.copilot:/home/devel/.copilot \
       -v ~/.opencode:/home/devel/.opencode \
       jianshao/ollama ollama $*